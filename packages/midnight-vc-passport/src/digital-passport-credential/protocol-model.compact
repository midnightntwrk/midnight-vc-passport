export struct DigitalPassportIssuanceOfferBody {
  supportsExpiration: Boolean,
  defaultExpirationDays: Uint<16>,
  requiresHolderPublicKey: Boolean,
}

export struct DigitalPassportIssuanceRequestBody {
  holderBinding: ExplicitHolderBinding,
  holderPublicKey: JubjubPoint,
  holderChallengeHash: Bytes<32>,
  requestExpiration: Boolean,
  requestedExpirationDays: Uint<16>,
}

export struct DigitalPassportIssuanceResultBody {
  credential: DigitalPassportCredential,
  credentialProof: Proof,
  holderPublicKey: JubjubPoint,
  issuanceChallengeHash: Bytes<32>,
  privateParts: DigitalPassportCredentialPrivateParts,
}

export struct DigitalPassportVerificationRequestBody {
  requireFirstNameDisclosure: Boolean,
  requireLastNameDisclosure: Boolean,
  requireAgeOverThreshold: Boolean,
  requestedAgeThresholdYears: Uint<8>,
  requireDocumentNumberDisclosure: Boolean,
  requireIssuingStateDisclosure: Boolean,
}

export struct DigitalPassportVerificationSubmissionBody {
  credential: DigitalPassportCredential,
  credentialProof: Proof,
  presentation: DigitalPassportPresentation,
  presentationProof: Proof,
}

export struct DigitalPassportVerificationResultBody {
  credentialRoot: Bytes<32>,
  verifiedThresholdYears: Uint<8>,
}

// =====================
// Protocol message envelopes (family-owned choreography)
// =====================
// The generic `Issue`/`Present` choreography modules were removed from the
// core contract layer (`credential-compact@0.2.0-rc1`). The message shapes and
// their envelope-alignment circuits are folded here as concrete, prefixed
// instantiations over the family bodies above, replacing the former prefixed
// generic instantiations (`import Issue<...> prefix DigitalPassportIssuance_`).
// See `protocol-envelope.compact` for the vendored envelope primitives.

export struct DigitalPassportIssuance_OfferMessage {
  envelope: ProtocolMessageEnvelope,
  schema: SchemaRef,
  issuerVerificationMethodRef: VerificationMethodRef,
  holderBindingProfile: HolderBindingProfile,
  features: CredentialProtocolFeatures,
  body: DigitalPassportIssuanceOfferBody,
}

export struct DigitalPassportIssuance_RequestMessage {
  envelope: ProtocolMessageEnvelope,
  schema: SchemaRef,
  issuerVerificationMethodRef: VerificationMethodRef,
  holderBindingProfile: HolderBindingProfile,
  body: DigitalPassportIssuanceRequestBody,
}

export struct DigitalPassportIssuance_ResultMessage {
  envelope: ProtocolMessageEnvelope,
  schema: SchemaRef,
  issuerVerificationMethodRef: VerificationMethodRef,
  holderBindingProfile: HolderBindingProfile,
  body: DigitalPassportIssuanceResultBody,
}

export pure circuit DigitalPassportIssuance_assertValidOfferMessage(
                      offer: DigitalPassportIssuance_OfferMessage
                      ): [] {
  assertValidProtocolMessageEnvelope(offer.envelope);
  assert(offer.envelope.initialMessage, "Issuance offer must be the initial message");
  assertValidVerificationMethodRef(offer.issuerVerificationMethodRef);
}

export pure circuit DigitalPassportIssuance_assertValidRequestMessage(
                      request: DigitalPassportIssuance_RequestMessage
                      ): [] {
  assertValidProtocolMessageEnvelope(request.envelope);
  assert(!request.envelope.initialMessage, "Issuance request must be a response message");
  assertValidVerificationMethodRef(request.issuerVerificationMethodRef);
}

export pure circuit DigitalPassportIssuance_assertOfferRequestAlignment(
                      offer: DigitalPassportIssuance_OfferMessage,
                      request: DigitalPassportIssuance_RequestMessage
                      ): [] {
  DigitalPassportIssuance_assertValidOfferMessage(offer);
  DigitalPassportIssuance_assertValidRequestMessage(request);
  assertProtocolResponseEnvelope(offer.envelope, request.envelope);
  assertMatchingSchemaRefs(offer.schema, request.schema);
  assert(offer.issuerVerificationMethodRef.controllerAddress ==
         request.issuerVerificationMethodRef.controllerAddress
         && offer.issuerVerificationMethodRef.methodId == request.issuerVerificationMethodRef.methodId,
         "Issuance request issuer verification method does not match the offer"
         );
  assert(offer.holderBindingProfile == request.holderBindingProfile,
         "Issuance request holder binding profile does not match the offer"
         );
}

export pure circuit DigitalPassportIssuance_assertValidResultMessage(
                      result: DigitalPassportIssuance_ResultMessage
                      ): [] {
  assertValidProtocolMessageEnvelope(result.envelope);
  assert(!result.envelope.initialMessage, "Issuance result must be a response message");
  assertValidVerificationMethodRef(result.issuerVerificationMethodRef);
}

export pure circuit DigitalPassportIssuance_assertRequestResultAlignment(
                      request: DigitalPassportIssuance_RequestMessage,
                      result: DigitalPassportIssuance_ResultMessage
                      ): [] {
  DigitalPassportIssuance_assertValidRequestMessage(request);
  DigitalPassportIssuance_assertValidResultMessage(result);
  assertProtocolResponseEnvelope(request.envelope, result.envelope);
  assertMatchingSchemaRefs(request.schema, result.schema);
  assert(request.issuerVerificationMethodRef.controllerAddress ==
         result.issuerVerificationMethodRef.controllerAddress
         && request.issuerVerificationMethodRef.methodId == result.issuerVerificationMethodRef.methodId,
         "Issuance result issuer verification method does not match the request"
         );
  assert(request.holderBindingProfile == result.holderBindingProfile,
         "Issuance result holder binding profile does not match the request"
         );
}

export struct DigitalPassportVerification_RequestMessage {
  envelope: ProtocolMessageEnvelope,
  schema: SchemaRef,
  issuerVerificationMethodRef: VerificationMethodRef,
  holderBindingProfile: HolderBindingProfile,
  features: CredentialProtocolFeatures,
  verifierChallengeHash: Bytes<32>,
  body: DigitalPassportVerificationRequestBody,
}

export struct DigitalPassportVerification_SubmissionMessage {
  envelope: ProtocolMessageEnvelope,
  schema: SchemaRef,
  issuerVerificationMethodRef: VerificationMethodRef,
  holderBindingProfile: HolderBindingProfile,
  challengeHash: Bytes<32>,
  body: DigitalPassportVerificationSubmissionBody,
}

export struct DigitalPassportVerification_ResultMessage {
  envelope: ProtocolMessageEnvelope,
  approved: Boolean,
  body: DigitalPassportVerificationResultBody,
}

export pure circuit DigitalPassportVerification_assertValidRequestMessage(
                      request: DigitalPassportVerification_RequestMessage
                      ): [] {
  assertValidProtocolMessageEnvelope(request.envelope);
  assert(request.envelope.initialMessage, "Presentation request must be the initial message");
  assertValidVerificationMethodRef(request.issuerVerificationMethodRef);
}

export pure circuit DigitalPassportVerification_assertValidSubmissionMessage(
                      submission: DigitalPassportVerification_SubmissionMessage
                      ): [] {
  assertValidProtocolMessageEnvelope(submission.envelope);
  assert(!submission.envelope.initialMessage,
         "Presentation submission must be a response message"
         );
  assertValidVerificationMethodRef(submission.issuerVerificationMethodRef);
}

export pure circuit DigitalPassportVerification_assertRequestSubmissionAlignment(
                      request: DigitalPassportVerification_RequestMessage,
                      submission: DigitalPassportVerification_SubmissionMessage
                      ): [] {
  DigitalPassportVerification_assertValidRequestMessage(request);
  DigitalPassportVerification_assertValidSubmissionMessage(submission);
  assertProtocolResponseEnvelope(request.envelope, submission.envelope);
  assertMatchingSchemaRefs(request.schema, submission.schema);
  assert(request.issuerVerificationMethodRef.controllerAddress ==
         submission.issuerVerificationMethodRef.controllerAddress
         && request.issuerVerificationMethodRef.methodId == submission.issuerVerificationMethodRef.methodId,
         "Presentation submission issuer verification method does not match the request"
         );
  assert(request.holderBindingProfile == submission.holderBindingProfile,
         "Presentation submission holder binding profile does not match the request"
         );
  assert(request.verifierChallengeHash == submission.challengeHash,
         "Presentation submission challenge does not match the request challenge"
         );
}

export pure circuit DigitalPassportVerification_assertValidResultMessage(
                      result: DigitalPassportVerification_ResultMessage
                      ): [] {
  assertValidProtocolMessageEnvelope(result.envelope);
  assert(!result.envelope.initialMessage, "Presentation result must be a response message");
}

export pure circuit DigitalPassportVerification_assertSubmissionResultAlignment(
                      submission: DigitalPassportVerification_SubmissionMessage,
                      result: DigitalPassportVerification_ResultMessage
                      ): [] {
  DigitalPassportVerification_assertValidSubmissionMessage(submission);
  DigitalPassportVerification_assertValidResultMessage(result);
  assertProtocolResponseEnvelope(submission.envelope, result.envelope);
}
